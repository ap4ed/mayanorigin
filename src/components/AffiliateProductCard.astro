---
import { getAffiliateProduct, buildAmazonUrl, type AffiliateProduct } from '../data/affiliate-products';

interface Props {
  productId?: string;
  product?: AffiliateProduct;
  badge?: string;
  badgeColor?: string;
}

const {
  productId,
  product: productProp,
  badge,
  badgeColor = '#c9943a',
} = Astro.props;

const product = productProp ?? (productId ? getAffiliateProduct(productId) : undefined);
if (!product) throw new Error(`Affiliate product not found: ${productId}`);

const link = buildAmazonUrl(product.asin);

const imageUrl = product.image
  ?? `https://ws-na.amazon-adsystem.com/widgets/q?_encoding=UTF8&ASIN=${product.asin}&Format=_SL250_&ID=AsinImage&MarketPlace=US&ServiceVersion=20070822&WS=1&tag=mayanorigin-20`;

const numericPrice = product.price ? parseFloat(product.price.replace(/[^0-9.]/g, '')) : null;

const productSchema = numericPrice ? {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.tagline,
  brand: { '@type': 'Brand', name: product.brand },
  image: imageUrl,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: product.rating,
    reviewCount: product.reviews.replace(/[^0-9]/g, ''),
    bestRating: '5',
  },
  review: {
    '@type': 'Review',
    author: { '@type': 'Organization', name: 'Mayan Origin Coffee' },
    reviewBody: product.why,
  },
  offers: {
    '@type': 'Offer',
    url: link,
    priceCurrency: 'USD',
    price: numericPrice.toFixed(2),
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'Amazon' },
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: 'US',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: 30,
      returnMethod: 'https://schema.org/ReturnByMail',
      returnFees: 'https://schema.org/FreeReturn',
    },
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'USD' },
      shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'US' },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' },
        transitTime: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 5, unitCode: 'DAY' },
      },
    },
  },
} : null;
---

{productSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
)}

<div class="apc-card">
  {badge && (
    <div class="apc-badge" style={`background:${badgeColor}`}>{badge}</div>
  )}
  <div class="apc-inner">
    <div class="apc-img-wrap">
      <a href={link} target="_blank" rel="noopener nofollow">
        <img
          src={imageUrl}
          alt={product.name}
          class="apc-img"
          loading="lazy"
          onerror="this.closest('.apc-img-wrap').style.display='none'"
        />
      </a>
    </div>
    <div class="apc-body">
      <h3 class="apc-name">
        <a href={link} target="_blank" rel="noopener nofollow">{product.name}</a>
      </h3>
      <p class="apc-tagline">{product.tagline}</p>
      <div class="apc-rating">
        <span class="apc-stars">{'★'.repeat(Math.round(parseFloat(product.rating)))}{'☆'.repeat(5 - Math.round(parseFloat(product.rating)))}</span>
        <span class="apc-rating-num">{product.rating}</span>
        <span class="apc-reviews">{product.reviews}</span>
      </div>
      <div class="apc-buy-row">
        <div class="apc-price-block">
          {product.listPrice && product.listPrice !== product.price && (
            <span class="apc-list-price">{product.listPrice}</span>
          )}
          <span class="apc-price">{product.price}</span>
          {product.discount && <span class="apc-discount">{product.discount}</span>}
        </div>
        <a href={link} target="_blank" rel="noopener nofollow sponsored" class="apc-btn"
           data-affiliate-name={product.name} data-affiliate-price={product.price}>
          View on Amazon &rarr;
        </a>
      </div>
      <p class="apc-price-disclaimer">Approximate price &middot; Check current price on Amazon</p>
      <div class="apc-why">
        <span class="apc-why-label">Why we recommend it:</span> {product.why}
      </div>
    </div>
  </div>
</div>

<style>
  .apc-card {
    border: 1px solid var(--border, #e4ddd4);
    border-radius: 14px;
    overflow: hidden;
    margin: 1.75rem 0;
    transition: box-shadow 0.2s;
    background: #fff;
  }
  .apc-card:hover {
    box-shadow: 0 6px 24px rgba(27, 46, 27, 0.1);
  }
  .apc-badge {
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 0.35rem 1rem;
    font-family: 'DM Sans', sans-serif;
  }
  .apc-inner {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    align-items: flex-start;
  }
  .apc-img-wrap {
    flex-shrink: 0;
    width: 140px;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cream, #faf8f4);
    border-radius: 10px;
    overflow: hidden;
  }
  .apc-img {
    width: 140px;
    height: 140px;
    object-fit: contain;
  }
  .apc-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .apc-name {
    font-size: 1.15rem;
    margin: 0;
    line-height: 1.3;
    font-family: 'Cinzel', Georgia, serif;
  }
  .apc-name a {
    color: var(--green, #1b2e1b);
    text-decoration: none;
  }
  .apc-name a:hover { text-decoration: underline; }
  .apc-tagline {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted, #6b6b6b);
    font-style: italic;
  }
  .apc-rating {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
  }
  .apc-stars {
    color: #FF9900;
    letter-spacing: -1px;
  }
  .apc-rating-num {
    font-weight: 600;
    color: var(--green, #1b2e1b);
  }
  .apc-reviews {
    color: var(--muted, #6b6b6b);
  }
  .apc-buy-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.25rem 0;
    flex-wrap: wrap;
  }
  .apc-price-block {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .apc-price {
    font-size: 1.1rem;
    font-weight: 700;
    color: #B12704;
  }
  .apc-list-price {
    font-size: 0.9rem;
    color: var(--muted, #6b6b6b);
    text-decoration: line-through;
  }
  .apc-discount {
    font-size: 0.8rem;
    font-weight: 700;
    color: #fff;
    background: #B12704;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }
  .apc-price-disclaimer {
    font-size: 0.72rem;
    color: #aaa;
    margin: 0.2rem 0 0.5rem;
  }
  .apc-btn {
    background: var(--green, #1b2e1b);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s;
    white-space: nowrap;
  }
  .apc-btn:hover { background: var(--gold, #c9943a); color: #fff; }
  .apc-why {
    font-size: 0.9rem;
    color: var(--text, #2d2d2d);
    line-height: 1.7;
    margin: 0;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border, #e4ddd4);
  }
  .apc-why-label {
    font-weight: 700;
    color: var(--green, #1b2e1b);
  }

  @media (max-width: 520px) {
    .apc-inner { flex-direction: column; }
    .apc-img-wrap { width: 100%; height: 200px; }
    .apc-img { width: 100%; height: 200px; }
  }
</style>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('[data-affiliate-name]') as HTMLAnchorElement | null;
    if (!btn) return;
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', 'affiliate_click', {
        product_name: btn.dataset.affiliateName,
        price: btn.dataset.affiliatePrice,
        link: btn.href,
      });
    }
  });
</script>
