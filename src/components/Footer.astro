---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">

    <!-- Top section: brand + nav columns -->
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Mayan Origin Coffee">
          <img src="/logo.png" alt="" class="footer-logo-img" width="64" height="64" aria-hidden="true" />
          <span><span class="logo-mayan">Mayan</span><span class="logo-origin"> Origin</span></span>
        </a>
        <p class="footer-about">
          Single-origin coffee from Copán, Honduras. Roasted in small batches and shipped directly to your door.
        </p>
        <div class="footer-social">
          <!-- Instagram -->
          <a href="#" class="social-icon" aria-label="Instagram" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
            </svg>
          </a>
          <!-- TikTok -->
          <a href="#" class="social-icon" aria-label="TikTok" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V9.61a8.16 8.16 0 0 0 4.77 1.52V7.68a4.85 4.85 0 0 1-1-.99z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Nav: Shop -->
      <div class="footer-nav">
        <p class="footer-nav-title">Shop</p>
        <ul>
          <li><a href="/shop/">All Coffees</a></li>
          <li><a href="/shop/balam/">Balam — Dark Roast</a></li>
          <li><a href="/shop/ixchel/">Ixchel — Light Roast</a></li>
          <li><a href="/shop/kukulkan/">Kukulkan — Medium Roast</a></li>
        </ul>
      </div>

      <!-- Nav: Company -->
      <div class="footer-nav">
        <p class="footer-nav-title">Company</p>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/cart/">Shipping</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="copyright">© {year} Mayan Origin Coffee · Honduras</p>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background: #111;
    color: #bbb;
    margin-top: 5rem;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Top section */
  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  /* Brand */
  .footer-logo {
    font-family: 'Cinzel', Georgia, serif;
    font-size: 1.6rem;
    font-weight: 700;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    letter-spacing: 0.5px;
  }
  .footer-logo-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .logo-mayan  { color: #fff; }
  .logo-origin { color: #c9943a; }

  .footer-about {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: #888;
    max-width: 340px;
  }

  /* Social icons */
  .footer-social {
    display: flex;
    gap: 0.6rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.15);
    color: #999;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .social-icon:hover {
    border-color: #c9943a;
    color: #c9943a;
  }

  /* Nav columns */
  .footer-nav-title {
    font-weight: 700;
    color: #fff;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin: 0 0 1rem;
    font-family: 'DM Sans', sans-serif;
  }

  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-nav a {
    color: #888;
    text-decoration: none;
    font-size: 0.9rem;
    font-family: 'DM Sans', sans-serif;
    transition: color 0.15s;
  }
  .footer-nav a:hover { color: #c9943a; }

  /* Bottom bar */
  .footer-bottom {
    padding: 1.5rem 0;
    text-align: center;
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .copyright {
    font-size: 0.78rem;
    color: #444;
    margin: 0;
    font-family: 'DM Sans', sans-serif;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
    .footer-about { max-width: 100%; }
  }

  @media (max-width: 480px) {
    .footer-top { grid-template-columns: 1fr; }
    .footer-logo { font-size: 1.6rem; }
  }
</style>
