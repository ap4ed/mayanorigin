---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = [
  { value: 'all', label: 'All Posts' },
  { value: 'culture', label: 'Mayan Culture' },
  { value: 'recipes', label: 'Recipes' },
  { value: 'brew-guides', label: 'Brew Guides' },
  { value: 'origin', label: 'Origin & Sourcing' },
];

const categoryLabels: Record<string, string> = {
  culture: 'Mayan Culture',
  recipes: 'Recipes',
  'brew-guides': 'Brew Guides',
  origin: 'Origin & Sourcing',
};
---

<BaseLayout
  title="Journal — Mayan Origin Coffee"
  description="Stories from the highlands of Copán. Mayan gods, ancient recipes, brew guides, and the people behind the coffee."
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "@id": "https://mayanorigin.com/blog/",
        "name": "Journal — Mayan Origin Coffee",
        "description": "Stories from the highlands of Copán. Mayan gods, ancient recipes, brew guides, and the people behind the coffee.",
        "url": "https://mayanorigin.com/blog/",
        "breadcrumb": {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mayanorigin.com/" },
            { "@type": "ListItem", "position": 2, "name": "Journal", "item": "https://mayanorigin.com/blog/" }
          ]
        }
      }
    ]
  })} />

  <section class="blog-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Journal</span>
      </nav>
      <h1>The Journal</h1>
      <p>Stories from the highlands. Mayan gods, ancient recipes, and the people who grow your coffee.</p>
    </div>
  </section>

  <section class="blog-section">
    <div class="container">

      <!-- Category filter -->
      <div class="category-filter" role="group" aria-label="Filter by category">
        {categories.map(cat => (
          <button class={`filter-btn${cat.value === 'all' ? ' active' : ''}`} data-cat={cat.value}>
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Posts grid -->
      <div class="posts-grid" id="postsGrid">
        {posts.map(post => (
          <article class="post-card" data-category={post.data.category}>
            <a href={`/blog/${post.id}/`} class="post-image-link" tabindex="-1" aria-hidden="true">
              <div class="post-image">
                {post.data.image
                  ? <img src={post.data.image} alt={post.data.imageAlt ?? post.data.title} loading="lazy" width="600" height="380" />
                  : <div class="post-image-placeholder">📖</div>
                }
                <span class="cat-badge">{categoryLabels[post.data.category]}</span>
              </div>
            </a>
            <div class="post-body">
              <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <a href={`/blog/${post.id}/`} class="post-title-link">
                <h2 class="post-title">{post.data.title}</h2>
              </a>
              <p class="post-desc">{post.data.description}</p>
              <a href={`/blog/${post.id}/`} class="read-more">Read more →</a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.post-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.dataset.cat;
      cards.forEach(card => {
        const show = cat === 'all' || card.dataset.category === cat;
        (card as HTMLElement).style.display = show ? '' : 'none';
      });
    });
  });
</script>

<style>
  .blog-hero {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--muted);
    font-family: 'DM Sans', sans-serif;
    margin-bottom: 1rem;
  }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--gold); }

  .blog-hero h1 { font-size: clamp(1.8rem, 3vw, 2.5rem); margin: 0 0 0.5rem; }
  .blog-hero p { color: var(--muted); margin: 0; }

  .blog-section { padding: 3rem 0 5rem; }

  /* Category filter */
  .category-filter {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    padding: 0.45rem 1rem;
    border: 2px solid var(--border);
    border-radius: 100px;
    background: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    color: var(--muted);
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .filter-btn:hover { border-color: var(--green); color: var(--green); }
  .filter-btn.active {
    border-color: var(--green);
    background: var(--green);
    color: #fff;
  }

  /* Posts grid */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .post-card {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.07);
    transition: box-shadow 0.2s, transform 0.2s;
    display: flex;
    flex-direction: column;
  }
  .post-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,0.1);
    transform: translateY(-3px);
  }

  .post-image-link { display: block; }
  .post-image {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #e8e0d4;
  }
  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s;
  }
  .post-card:hover .post-image img { transform: scale(1.04); }

  .post-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    background: #e8e0d4;
  }

  .cat-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: rgba(27,46,27,0.85);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    font-family: 'DM Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
  }

  .post-body {
    padding: 1.25rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--muted);
    font-family: 'DM Sans', sans-serif;
  }

  .post-title-link { text-decoration: none; }
  .post-title {
    font-size: 1.1rem;
    margin: 0;
    line-height: 1.3;
  }
  .post-title-link:hover .post-title { color: var(--gold); }

  .post-desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.65;
    margin: 0.25rem 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    font-size: 0.82rem;
    font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    color: var(--gold);
    text-decoration: none;
    margin-top: auto;
  }
  .read-more:hover { color: var(--green); }

  @media (max-width: 900px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .posts-grid { grid-template-columns: 1fr; }
  }
</style>
