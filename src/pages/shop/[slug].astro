---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, getProductBySlug } from '../../data/products';

export function getStaticPaths() {
  return products.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug!);
if (!product) return Astro.redirect('/shop/');

const otherProducts = products.filter(p => p.slug !== product.slug);

const bundleMap: Record<string, { name: string; description: string; price: number }[]> = {
  balam: [
    { name: 'Cacao Nibs', description: 'Raw Honduran cacao nibs', price: 12 },
    { name: 'Jimerito Honey', description: 'Raw highland honey from Copán', price: 14 },
  ],
  mut: [
    { name: 'Vanilla Beans', description: 'Whole vanilla beans, Grade A', price: 16 },
    { name: 'Jimerito Honey', description: 'Raw highland honey from Copán', price: 14 },
  ],
  kukulkan: [
    { name: 'Cacao Nibs', description: 'Raw Honduran cacao nibs', price: 12 },
    { name: 'Vanilla Beans', description: 'Whole vanilla beans, Grade A', price: 16 },
  ],
  'welchez-house-blend': [],
  'welchez-santa-isabel': [],
  'welchez-seasonal-blend': [],
  'welchez-signature-blend': [],
  'cafe-maya-coffee-club': [],
  'cafe-maya-reserva': [],
  'sigua-finca-el-zapote': [],
  'mythoz-classic': [],
};

const bundleItems = bundleMap[product.slug] ?? [];

