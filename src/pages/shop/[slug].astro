const productSpecs = specs[product.slug] ?? {};
const productBrewGuide = brewGuide[product.slug] ?? [];
const bundleTotal = Object.values(product.prices)[0] + bundleItems.reduce((s, i) => s + i.price, 0);
---

<BaseLayout
  title={product.metaTitle ?? `${product.name} — ${product.roast} | Mayan Origin Coffee`}
  description={product.metaDescription ?? product.description}
  ogType="product"
>
  <slot name="head">
    <!-- Product schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": `${product.name} — ${product.roast} Coffee`,
      "description": product.description,
      "image": `https://mayanorigin.com${product.image}`,
      "brand": { "@type": "Brand", "name": product.brand ?? "Mayan Origin Coffee" },
      "countryOfOrigin": { "@type": "Country", "name": "Honduras" },
      "category": "Coffee",
      "offers": Object.entries(product.prices).map(([size, price]) => ({
        "@type": "Offer",
        "name": size,
        "price": price,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "US" },
          "shippingRate": {
            "@type": "MonetaryAmount",
            "currency": "USD",
            "value": price >= 120 ? "0.00" : "35.00"
          },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "businessDays": { "@type": "QuantitativeValue", "minValue": 5, "maxValue": 10 }
          }
        },
        "url": `https://mayanorigin.com/shop/${product.slug}/`
      }))
    })} />

    <!-- BreadcrumbList schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mayanorigin.com/" },
        { "@type": "ListItem", "position": 2, "name": "Shop", "item": "https://mayanorigin.com/shop/" },
        { "@type": "ListItem", "position": 3, "name": product.name, "item": `https://mayanorigin.com/shop/${product.slug}/` }
      ]
    })} />

    <!-- FAQ schema (brew guide + shipping) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        ...productBrewGuide.map((step, i) => ({
          "@type": "Question",
          "name": i === 0 ? `How do I grind ${product.name} coffee?` :
                  i === 1 ? `What is the coffee-to-water ratio for ${product.name}?` :
                  i === 2 ? `What water temperature should I use for ${product.name}?` :
                  i === 3 ? `How long should I brew ${product.name}?` :
                  `Best brewing tip for ${product.name}?`,
          "acceptedAnswer": { "@type": "Answer", "text": step }
        })),
        {
          "@type": "Question",
          "name": `How long does shipping take for ${product.name}?`,
          "acceptedAnswer": { "@type": "Answer", "text": `${product.name} ships directly from Honduras via DHL Express. Delivery to the United States typically takes 5 to 10 business days. Shipping costs $35 per order, or is free on orders over $120.` }
        },
        {
          "@type": "Question",
          "name": `Where does ${product.name} ship from?`,
          "acceptedAnswer": { "@type": "Answer", "text": `${product.name} is packed and ships directly from Honduras. Every order is packed fresh before shipping via DHL Express international to the United States.` }
        },
        {
          "@type": "Question",
          "name": `Is ${product.name} available in the United States?`,
          "acceptedAnswer": { "@type": "Answer", "text": `${product.name} is exclusively available through Mayan Origin at mayanorigin.com. It is not sold in US retail stores. Orders ship directly from Honduras to your door via DHL Express.` }
        }
      ]
    })} />
  </slot>

  <div class="pdp-wrap container">

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/shop/">Shop</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{product.name}</span>
    </nav>

    <!-- Top 2-col grid -->
    <div class="pdp-top">

      <!-- Left: image gallery -->
      <div class="pdp-gallery">
        <div class="gallery-main">
          <img
            src={product.image}
            alt={`${product.name} — ${product.subtitle} Honduras specialty coffee bag`}
            width="600"
            height="600"
            loading="eager"
            class="gallery-img"
            id="galleryMain"
          />
          <span class="roast-badge">{product.roast}</span>
        </div>
      </div>

      <!-- Right: purchase module -->
      <div class="pdp-purchase">
        <span class="roast-tag">{product.roast}</span>
        <h1 class="pdp-name">{product.name} <span class="pdp-subtitle">— {product.subtitle}</span></h1>

        <!-- Trustpilot placeholder -->
        <div class="tp-placeholder" aria-label="Reviews coming soon">
          <span class="stars">★★★★★</span>
          <span class="tp-text">Reviews coming soon</span>
        </div>

        <!-- Flavor chips -->
        <div class="flavor-chips">
          {productHighlights.slice(2, 3)[0]?.replace('Tasting notes: ', '').split(', ').map(note => (
            <span class="chip">{note}</span>
          ))}
        </div>

        <!-- Live price -->
        <div class="live-price">
          <span class="price-display" id="priceDisplay">$17</span>
          <span class="price-note" id="priceNote"></span>
        </div>

        <!-- Size selector -->
        <div class="size-selector">
          <p class="selector-label">Size</p>
          <div class="size-buttons" role="group" aria-label="Select size">
            {Object.entries(product.prices).map(([size, price], i) => {
              const isGround = size.toLowerCase().includes('ground');
              const imgSrc = isGround && product.secondaryImage ? product.secondaryImage : product.image;
              return (
                <button
                  class={`size-btn${i === 0 ? ' active' : ''}`}
                  data-size={size}
                  data-price={price}
                  data-image={imgSrc}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {size}
                  <span class="size-price">${price}</span>
                </button>
              );
            })}
          </div>
        </div>

        <!-- Quantity selector -->
        <div class="qty-selector">
          <p class="selector-label">Quantity</p>
          <div class="qty-controls">
            <button class="qty-btn" id="qtyMinus" aria-label="Decrease quantity">−</button>
            <span class="qty-value" id="qtyValue">1</span>
            <button class="qty-btn" id="qtyPlus" aria-label="Increase quantity">+</button>
          </div>
        </div>

        <!-- CTAs -->
        <div class="cta-stack">
          <button class="btn btn-primary btn-full" id="addToCart">Add to Cart</button>
          <button class="btn btn-outline btn-full btn-green" id="buyNow">Buy Now</button>
        </div>

        <p class="guest-note">No account needed — checkout as guest in seconds.</p>

        <!-- Reassurance -->
        <ul class="reassurance">
          <li><span class="check">✓</span> Free FedEx/DHL Express shipping worldwide on orders over $100</li>
          <li><span class="check">✓</span> Every order packed fresh in Honduras</li>
          <li><span class="check">✓</span> 30-day satisfaction guarantee</li>
        </ul>

        <!-- Freshness signal -->
        <p class="freshness">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Ships within 3 business days from Honduras
        </p>
      </div>
    </div>

    <!-- Below-fold sections -->
    <div class="pdp-sections">

      <!-- Top Highlights -->
      <section class="pdp-section">
        <h2>About {product.name}</h2>
        <p class="product-description">{product.description}</p>
        <ul class="highlights-list">
          {productHighlights.map(h => (
            <li><span class="check">✓</span> {h}</li>
          ))}
        </ul>
      </section>

      <!-- Ingredients -->
      <section class="pdp-section">
        <h2>Ingredients</h2>
        <p>{product.ingredients ?? '100% Single-Origin Arabica Coffee — Copán, Honduras. Nothing added. Nothing removed.'}</p>
      </section>

      <!-- Item Details -->
      <section class="pdp-section">
        <h2>Item Details</h2>
        <dl class="spec-table">
          {Object.entries(productSpecs).map(([key, val]) => (
            <>
              <dt>{key}</dt>
              <dd>{val}</dd>
            </>
          ))}
        </dl>
      </section>

      <!-- Weight & Packaging -->
      <section class="pdp-section">
        <h2>Weight &amp; Packaging</h2>
        <table class="weight-table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Approx. Cups</th>
              <th>Price</th>
            </tr>
          </thead>
          <tbody>
            {Object.entries(product.prices).map(([size, price]) => {
              const cups: Record<string, string> = {
                '250g': '~25 cups', '500g': '~50 cups', '1kg': '~100 cups',
                '12oz': '~34 cups', '48oz': '~135 cups',
                '340g': '~34 cups', '454g': '~45 cups',
              };
              return (
                <tr>
                  <td>{size}</td>
                  <td>{cups[size] ?? '—'}</td>
                  <td>${price}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>

      <!-- Brew Guide -->
      <section class="pdp-section">
        <h2>Brew Guide</h2>
        <ul class="brew-list">
          {productBrewGuide.map(step => (
            <li>{step}</li>
          ))}
        </ul>
      </section>

      <!-- Shipping & Returns -->
      <section class="pdp-section">
        <h2>Shipping &amp; Returns</h2>
        <ul class="shipping-list">
          <li><span class="check">✓</span> Ships worldwide from Honduras via FedEx/DHL Express — 7–14 business days</li>
          <li><span class="check">✓</span> Free Express shipping on orders over $100</li>
          <li><span class="check">✓</span> 30-day satisfaction guarantee — if you're not happy, we'll make it right</li>
          <li><span class="check">✓</span> Tracking number sent by email once shipped</li>
        </ul>
      </section>
    </div>

    <!-- Reviews placeholder -->
    <section class="reviews-section">
      <h2>Customer Reviews</h2>
      <div class="review-placeholder">
        <p>Be the first to review {product.name}.</p>
        <p class="review-sub">Reviews will appear here once customers share their experience.</p>
      </div>
    </section>

    <!-- Frequently Bought Together -->
    {bundleItems.length > 0 && (
      <section class="bundle-section">
        <h2>Frequently Bought Together</h2>
        <div class="bundle-row">
          <div class="bundle-item">
            <div class="bundle-img-placeholder">☕</div>
            <p class="bundle-name">{product.name}</p>
            <p class="bundle-price">${product.prices['250g']}</p>
          </div>
          {bundleItems.map(item => (
            <>
              <span class="bundle-plus" aria-hidden="true">+</span>
              <div class="bundle-item">
                <div class="bundle-img-placeholder">🌿</div>
                <p class="bundle-name">{item.name}</p>
                <p class="bundle-desc">{item.description}</p>
                <p class="bundle-price">${item.price}</p>
              </div>
            </>
          ))}
        </div>
        <div class="bundle-cta">
          <p class="bundle-total">Bundle total: <strong>${bundleTotal}</strong></p>
          <button class="btn btn-primary" id="addBundle">Add All to Cart</button>
        </div>
      </section>
    )}

    <!-- You May Also Like -->
    <section class="also-like-section">
      <h2>You May Also Like</h2>
      <div class="also-like-grid">
        {otherProducts.map(p => (
          <ProductCard product={p} />
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<script define:vars={{ slug: product.slug }}>
  // Read all state from the DOM — no prices object needed
  let qty = 1;

  const priceDisplay = document.getElementById('priceDisplay');
  const priceNote = document.getElementById('priceNote');
  const qtyValue = document.getElementById('qtyValue');

  function getActiveBtn() {
    return document.querySelector('.size-btn.active');
  }

  function getSelectedSize() {
    return getActiveBtn()?.getAttribute('data-size') ?? '';
  }

  function getUnitPrice() {
    return Number(getActiveBtn()?.getAttribute('data-price') ?? 0);
  }

  function updatePrice() {
    const unitPrice = getUnitPrice();
    const total = unitPrice * qty;
    if (priceDisplay) priceDisplay.textContent = `$${total}`;
    if (priceNote) priceNote.textContent = qty > 1 ? `($${unitPrice} × ${qty})` : '';
  }

  // Size buttons
  document.querySelectorAll('.size-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.size-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      updatePrice();

      // Swap main image if button carries a data-image
      const imgSrc = btn.getAttribute('data-image');
      const main = document.getElementById('galleryMain');
      if (imgSrc && main) main.src = imgSrc;
    });
  });

  // Qty
  document.getElementById('qtyMinus')?.addEventListener('click', () => {
    if (qty > 1) { qty--; if (qtyValue) qtyValue.textContent = String(qty); updatePrice(); }
  });
  document.getElementById('qtyPlus')?.addEventListener('click', () => {
    if (qty < 10) { qty++; if (qtyValue) qtyValue.textContent = String(qty); updatePrice(); }
  });

  // Add to Cart
  document.getElementById('addToCart')?.addEventListener('click', () => {
    try {
      const cart = JSON.parse(localStorage.getItem('mo_cart') || '[]');
      const selectedSize = getSelectedSize();
      const price = getUnitPrice();
      const existing = cart.find(i => i.slug === slug && i.size === selectedSize);
      if (existing) {
        existing.qty = Math.min(10, existing.qty + qty);
      } else {
        cart.push({ slug, size: selectedSize, qty, price });
      }
      localStorage.setItem('mo_cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('mo:cart-updated'));
      const btn = document.getElementById('addToCart');
      if (btn) {
        btn.textContent = 'Added!';
        setTimeout(() => { btn.textContent = 'Add to Cart'; }, 1800);
      }
    } catch {}
  });

  // Buy Now — direct to Stripe checkout
  document.getElementById('buyNow')?.addEventListener('click', async () => {
    const btn = document.getElementById('buyNow');
    btn.textContent = 'Redirecting…';
    btn.disabled = true;

    try {
      const res = await fetch('/api/create-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ slug, size: getSelectedSize(), qty, price: getUnitPrice() }] }),
      });
      const data = await res.json();
      if (data.url) {
        window.location.href = data.url;
      } else {
        alert(data.error ?? 'Checkout unavailable. Please try again.');
        btn.textContent = 'Buy Now';
        btn.disabled = false;
      }
    } catch {
      alert('Connection error. Please try again.');
      btn.textContent = 'Buy Now';
      btn.disabled = false;
    }
  });

  // Add Bundle — placeholder
  document.getElementById('addBundle')?.addEventListener('click', () => {
    document.getElementById('addToCart')?.click();
  });

  updatePrice();

</script>

