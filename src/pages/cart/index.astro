---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';

const productImageMap = Object.fromEntries(products.map(p => [p.slug, p.image]));
const minProductPrice = Math.min(...products.map(p => Math.min(...Object.values(p.prices))));
---

<BaseLayout
  title="Your Cart — Mayan Origin Coffee"
  description="Review your cart and proceed to checkout."
>

  <div class="cart-wrap container">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Cart</span>
    </nav>

    <h1>Your Cart</h1>

    <!-- Empty state (shown by default, hidden via JS when cart has items) -->
    <div class="cart-empty" id="cartEmpty">
      <div class="empty-icon">🛒</div>
      <h2>Your cart is empty</h2>
      <p>You haven't added anything yet. Browse our coffees and find your roast.</p>
      <a href="/shop/" class="btn btn-primary">Shop All Coffees</a>
    </div>

    <!-- Cart with items (hidden by default, shown via JS) -->
    <div class="cart-filled" id="cartFilled" hidden>
      <div class="cart-layout">

        <!-- Line items -->
        <div class="cart-items" id="cartItems">
          <!-- Populated by JS -->
        </div>

        <!-- Gift tee (shown when subtotal >= $120) -->
        <div class="gift-tee-section" id="giftTeeSection" hidden>
          <div class="gift-tee-header">
            <span class="gift-tee-icon">🎁</span>
            <div>
              <p class="gift-tee-title">Free Tee — Yours on Us!</p>
              <p class="gift-tee-sub">Your order qualifies for a complimentary Mayan Origin Coffee Co. tee</p>
            </div>
          </div>
          <div class="gift-tee-options">
            <div class="gift-tee-field">
              <label class="gift-tee-label">Size</label>
              <div class="gift-tee-buttons">
                <button class="tee-btn" data-tee-size="S">S</button>
                <button class="tee-btn" data-tee-size="M">M</button>
                <button class="tee-btn" data-tee-size="L">L</button>
              </div>
            </div>
            <div class="gift-tee-field">
              <label class="gift-tee-label">Color</label>
              <div class="gift-tee-buttons">
                <button class="tee-btn tee-color-btn" data-tee-color="White">
                  <span class="color-swatch swatch-white"></span> White
                </button>
                <button class="tee-btn tee-color-btn" data-tee-color="Black">
                  <span class="color-swatch swatch-black"></span> Black
                </button>
              </div>
            </div>
          </div>
          <p class="gift-tee-reminder" hidden>Please select a size and color to claim your free tee</p>
        </div>

        <!-- Order summary -->
        <div class="cart-summary">
          <h2>Order Summary</h2>

          <div class="summary-rows" id="summaryRows">
            <!-- Populated by JS -->
          </div>

          <div class="summary-subtotal">
            <span>Subtotal</span>
            <span id="cartSubtotal">$0</span>
          </div>

          <div id="shippingProgress" class="shipping-progress" hidden>
            <p id="shippingProgressLabel" class="shipping-progress-label"></p>
            <div class="progress-track">
              <div id="progressBar" class="progress-bar"></div>
            </div>
          </div>

          <div class="summary-shipping">
            <span>Shipping</span>
            <span id="shippingCost">$35.00</span>
          </div>
          <p id="shippingSavings" class="shipping-savings" hidden></p>

          <div class="summary-total">
            <span>Total</span>
            <span id="cartTotal">$0</span>
          </div>

          <button class="btn btn-primary btn-full" id="checkoutBtn">
            Proceed to Checkout
          </button>

          <p class="checkout-note">No account needed — checkout as guest in seconds.</p>

          <ul class="checkout-trust">
            <li><span class="check">✓</span> Secure checkout via Stripe</li>
            <li><span class="check">✓</span> Ships within 3 business days</li>
            <li><span class="check">✓</span> 30-day satisfaction guarantee</li>
          </ul>

          <div class="shipping-info">
            <p class="shipping-title">Worldwide Shipping</p>
            <p>Orders ship from Honduras via DHL Express. Estimated delivery: 5–10 business days.</p>
            <p>1 bag: $35 · 2 bags: $25 · 3 bags: $20 · Free over $120 · FedEx/DHL Express</p>
          </div>
        </div>

      </div>
    </div>

    <!-- You may also like -->
    <section class="also-like">
      <h2>You May Also Like</h2>
      <div class="also-grid">
        {products.map(p => <ProductCard product={p} />)}
      </div>
    </section>

  </div>
</BaseLayout>

<script define:vars={{ productImageMap, minProductPrice }}>
  window.__productImageMap = productImageMap;
  window.__minProductPrice = minProductPrice;
</script>

<script>
  const productImageMap: Record<string, string> = (window as any).__productImageMap || {};
  const minProductPrice: number = (window as any).__minProductPrice || 27;

  interface CartItem {
    slug: string;
    size: string;
    qty: number;
    price: number;
  }

  const PRODUCT_NAMES: Record<string, string> = {
    balam: 'Balam — Medium Roast',
    mut: 'Mut — Light Roast',
    kukulkan: 'Kukulkan — Dark Roast',
    'welchez-house-blend': 'House Blend — Café Welchez',
    'welchez-santa-isabel': 'Santa Isabel — Café Welchez',
    'cafe-maya-coffee-club': 'Coffee Club — Café Maya',
    'cafe-maya-reserva': 'Reserva — Café Maya',
    'sigua-finca-el-zapote': 'Finca El Zapote — Sigua Coffee',
    'mythoz-classic': 'Mythoz — Legacy Blend',
  };

  function loadCart(): CartItem[] {
    try {
      return JSON.parse(localStorage.getItem('mo_cart') || '[]');
    } catch {
      return [];
    }
  }

  function saveCart(cart: CartItem[]) {
    localStorage.setItem('mo_cart', JSON.stringify(cart));
    window.dispatchEvent(new Event('mo:cart-updated'));
  }

  function renderCart() {
    const cart = loadCart();
    const emptyEl = document.getElementById('cartEmpty');
    const filledEl = document.getElementById('cartFilled');
    const itemsEl = document.getElementById('cartItems');
    const summaryEl = document.getElementById('summaryRows');
    const totalEl = document.getElementById('cartTotal');
    const shippingEl = document.getElementById('shippingCost');
    const subtotalEl = document.getElementById('cartSubtotal');

    if (!emptyEl || !filledEl || !itemsEl || !summaryEl || !totalEl) return;

    if (cart.length === 0) {
      emptyEl.style.display = '';
      filledEl.hidden = true;
      return;
    }

    emptyEl.style.display = 'none';
    filledEl.hidden = false;

    const subtotal = cart.reduce((s, i) => s + i.price * i.qty, 0);
    const totalQty = cart.reduce((s, i) => s + i.qty, 0);

    function calcShipping(qty: number, sub: number): number {
      if (sub >= 120) return 0;
      if (qty >= 3) return 20;
      if (qty >= 2) return 25;
      return 35;
    }

    function shippingNudge(qty: number, sub: number): string {
      if (sub >= 120) return '';
      const remaining = 120 - sub;
      const oneMoreGetsFree = sub + minProductPrice >= 120;
      if (qty === 1) {
        if (oneMoreGetsFree) return 'Add 1 more bag and get <strong>free shipping!</strong>';
        return 'Add 1 more bag and save <strong>$10</strong> on shipping';
      }
      if (qty === 2) {
        if (oneMoreGetsFree) return 'Add 1 more bag and get <strong>free shipping!</strong>';
        return 'Add 1 more bag and save <strong>$5</strong> on shipping';
      }
      if (oneMoreGetsFree) return 'Add 1 more bag and get <strong>free shipping!</strong>';
      return `Spend <strong>$${remaining.toFixed(2)}</strong> more to get free shipping`;
    }

    const shippingFee = calcShipping(totalQty, subtotal);
    const nudge = shippingNudge(totalQty, subtotal);

    // Render items
    itemsEl.innerHTML = cart.map((item, idx) => `
      <div class="cart-item" data-idx="${idx}">
        <div class="item-image">
          ${productImageMap[item.slug] ? `<img src="${productImageMap[item.slug]}" alt="${PRODUCT_NAMES[item.slug] ?? item.slug}" />` : '☕'}
        </div>
        <div class="item-info">
          <p class="item-name">${PRODUCT_NAMES[item.slug] ?? item.slug}</p>
          <p class="item-size">${item.size}</p>
        </div>
        <div class="item-qty">
          <button class="qty-btn" data-action="minus" data-idx="${idx}">−</button>
          <span>${item.qty}</span>
          <button class="qty-btn" data-action="plus" data-idx="${idx}">+</button>
        </div>
        <p class="item-price">$${(item.price * item.qty).toFixed(2)}</p>
        <button class="remove-btn" data-idx="${idx}" aria-label="Remove item">✕</button>
      </div>
    `).join('');

    // Summary rows
    summaryEl.innerHTML = cart.map(item => `
      <div class="summary-row">
        <span>${PRODUCT_NAMES[item.slug] ?? item.slug} (${item.size}) × ${item.qty}</span>
        <span>$${(item.price * item.qty).toFixed(2)}</span>
      </div>
    `).join('');

    if (subtotalEl) subtotalEl.textContent = `$${subtotal.toFixed(2)}`;

    const savingsEl = document.getElementById('shippingSavings');
    if (savingsEl) {
      if (shippingFee === 0) {
        savingsEl.hidden = true;
      } else if (totalQty === 2) {
        savingsEl.hidden = false;
        savingsEl.innerHTML = `2 bags — you saved <strong>$10</strong> on shipping`;
      } else if (totalQty >= 3) {
        savingsEl.hidden = false;
        savingsEl.innerHTML = `3 bags — you saved <strong>$15</strong> on shipping`;
      } else {
        savingsEl.hidden = true;
      }
    }
    totalEl.textContent = `$${(subtotal + shippingFee).toFixed(2)}`;
    if (shippingEl) {
      shippingEl.textContent = shippingFee === 0 ? 'Free' : `$${shippingFee}.00`;
    }

    const progressEl = document.getElementById('shippingProgress') as HTMLElement;
    const progressLabel = document.getElementById('shippingProgressLabel');
    const progressBar = document.getElementById('progressBar') as HTMLElement;

    if (progressEl && progressLabel && progressBar) {
      const pct = Math.min((subtotal / 120) * 120, 120);
      progressBar.style.width = `${pct}%`;

      if (subtotal >= 120) {
        progressEl.hidden = false;
        progressEl.classList.add('is-unlocked');
        progressLabel.innerHTML = '🎉 Free shipping unlocked!';
      } else {
        progressEl.hidden = false;
        progressEl.classList.remove('is-unlocked');
        const remaining = (120 - subtotal).toFixed(2);
        const oneMoreGetsFree = subtotal + minProductPrice >= 120;
        if (oneMoreGetsFree) {
          progressLabel.innerHTML = `Add 1 more bag and unlock <strong>free shipping!</strong>`;
        } else if (subtotal >= 80) {
          progressLabel.innerHTML = `So close! Just <strong>$${remaining}</strong> more for free shipping`;
        } else {
          progressLabel.innerHTML = `You're <strong>$${remaining}</strong> away from free shipping`;
        }
      }
    }

    // Gift tee section
    const giftTeeEl = document.getElementById('giftTeeSection') as HTMLElement;
    if (giftTeeEl) {
      if (subtotal >= 120) {
        giftTeeEl.hidden = false;
        const savedSize = localStorage.getItem('mo_tee_size') || '';
        const savedColor = localStorage.getItem('mo_tee_color') || '';
        giftTeeEl.querySelectorAll('[data-tee-size]').forEach(btn => {
          btn.classList.toggle('is-selected', (btn as HTMLElement).dataset.teeSize === savedSize);
        });
        giftTeeEl.querySelectorAll('[data-tee-color]').forEach(btn => {
          btn.classList.toggle('is-selected', (btn as HTMLElement).dataset.teeColor === savedColor);
        });
        const reminder = giftTeeEl.querySelector('.gift-tee-reminder') as HTMLElement;
        if (reminder) reminder.hidden = !!(savedSize && savedColor);
      } else {
        giftTeeEl.hidden = true;
      }
    }

    // Qty / remove handlers
    itemsEl.querySelectorAll('[data-action]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.idx ?? '0');
        const action = (btn as HTMLElement).dataset.action;
        const cart = loadCart();
        if (action === 'minus') {
          if (cart[idx].qty > 1) cart[idx].qty--;
          else cart.splice(idx, 1);
        } else {
          if (cart[idx].qty < 10) cart[idx].qty++;
        }
        saveCart(cart);
        renderCart();
      });
    });

    itemsEl.querySelectorAll('.remove-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.idx ?? '0');
        const cart = loadCart();
        cart.splice(idx, 1);
        saveCart(cart);
        renderCart();
      });
    });

    // Tee selection handlers
    document.querySelectorAll('[data-tee-size]').forEach(btn => {
      btn.addEventListener('click', () => {
        localStorage.setItem('mo_tee_size', (btn as HTMLElement).dataset.teeSize!);
        renderCart();
      });
    });
    document.querySelectorAll('[data-tee-color]').forEach(btn => {
      btn.addEventListener('click', () => {
        localStorage.setItem('mo_tee_color', (btn as HTMLElement).dataset.teeColor!);
        renderCart();
      });
    });
  }

  // Checkout — calls Stripe API
  document.getElementById('checkoutBtn')?.addEventListener('click', async () => {
    const cart = loadCart();
    if (cart.length === 0) return;

    const btn = document.getElementById('checkoutBtn') as HTMLButtonElement;

    // Validate tee selection if they qualify
    const subtotal = cart.reduce((s, i) => s + i.price * i.qty, 0);
    const teeSize = localStorage.getItem('mo_tee_size') || '';
    const teeColor = localStorage.getItem('mo_tee_color') || '';
    if (subtotal >= 120 && (!teeSize || !teeColor)) {
      const reminder = document.querySelector('.gift-tee-reminder') as HTMLElement;
      if (reminder) reminder.hidden = false;
      document.getElementById('giftTeeSection')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    btn.textContent = 'Redirecting to checkout…';
    btn.disabled = true;

    try {
      const res = await fetch('/api/create-checkout/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cart,
          ...(subtotal >= 120 && teeSize && teeColor ? { teeSize, teeColor } : {}),
        }),
      });
      const data = await res.json();
      if (data.url) {
        window.location.href = data.url;
      } else {
        alert(data.error ?? 'Checkout unavailable. Please try again.');
        btn.textContent = 'Proceed to Checkout';
        btn.disabled = false;
      }
    } catch {
      alert('Connection error. Please try again.');
      btn.textContent = 'Proceed to Checkout';
      btn.disabled = false;
    }
  });

  // Zip / shipping rate lookup
  document.getElementById('zipBtn')?.addEventListener('click', async () => {
    const zipInput = document.getElementById('zipInput') as HTMLInputElement;
    const ratesEl = document.getElementById('ratesResult') as HTMLDivElement;
    const zipBtn = document.getElementById('zipBtn') as HTMLButtonElement;
    const zip = zipInput?.value.trim();

    if (!zip || !/^\d{5}$/.test(zip)) {
      ratesEl.hidden = false;
      ratesEl.innerHTML = '<p class="rate-error">Enter a valid 5-digit US ZIP code.</p>';
      return;
    }

    const cart = loadCart();
    if (cart.length === 0) return;

    zipBtn.textContent = 'Loading…';
    zipBtn.disabled = true;
    ratesEl.hidden = true;

    try {
      const res = await fetch('/api/shipping-rate/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: cart, zipCode: zip }),
      });
      const data = await res.json();

      if (data.error) {
        ratesEl.hidden = false;
        ratesEl.innerHTML = `<p class="rate-error">${data.error}</p>`;
      } else if (!data.rates || data.rates.length === 0) {
        ratesEl.hidden = false;
        ratesEl.innerHTML = '<p class="rate-error">No rates found for this ZIP code.</p>';
      } else {
        ratesEl.hidden = false;
        ratesEl.innerHTML = data.rates.slice(0, 5).map((r: { provider: string; service: string; amount: number; days: number | null }) => `
          <div class="rate-row">
            <span class="rate-name">${r.provider} ${r.service}</span>
            <span class="rate-price">$${r.amount.toFixed(2)}${r.days ? ` · ${r.days}d` : ''}</span>
          </div>
        `).join('');
      }
    } catch {
      ratesEl.hidden = false;
      ratesEl.innerHTML = '<p class="rate-error">Connection error. Try again.</p>';
    }

    zipBtn.textContent = 'Get Rates';
    zipBtn.disabled = false;
  });

  renderCart();
  window.addEventListener('mo:cart-updated', renderCart);
</script>

<style>
  .cart-wrap {
    padding-top: 1.5rem;
    padding-bottom: 5rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--muted);
    font-family: 'DM Sans', sans-serif;
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--gold); }

  .cart-wrap h1 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 2rem; }

  /* Empty state */
  .cart-empty {
    text-align: center;
    padding: 5rem 0;
  }
  .empty-icon { font-size: 4rem; margin-bottom: 1rem; }
  .cart-empty h2 { font-size: 1.5rem; margin-bottom: 0.5rem; }
  .cart-empty p { color: var(--muted); margin-bottom: 1.5rem; }

  /* Cart layout */
  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 3rem;
    align-items: start;
    margin-bottom: 4rem;
  }

  /* Items */
  .cart-items { display: flex; flex-direction: column; gap: 1rem; }

  :global(.cart-item) {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: #fff;
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  :global(.item-image) {
    width: 72px;
    height: 72px;
    background: var(--cream);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    flex-shrink: 0;
    overflow: hidden;
  }
  :global(.item-image img) {
    width: 120%;
    height: 120%;
    object-fit: cover;
    border-radius: 6px;
  }

  :global(.item-info) { flex: 1; }
  :global(.item-name) {
    font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    margin: 0 0 0.2rem;
    color: var(--text);
  }
  :global(.item-size) { font-size: 0.82rem; color: var(--muted); margin: 0; font-family: 'DM Sans', sans-serif; }

  :global(.item-qty) {
    display: flex;
    align-items: center;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }
  :global(.qty-btn) {
    width: 32px;
    height: 32px;
    background: #fff;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    font-family: 'DM Sans', sans-serif;
    color: var(--text);
    transition: background 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  :global(.qty-btn:hover) { background: var(--cream); }
  :global(.item-qty span) {
    min-width: 32px;
    text-align: center;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
    padding: 0 0.25rem;
    line-height: 32px;
  }

  :global(.item-price) {
    font-weight: 700;
    font-family: 'DM Sans', sans-serif;
    color: var(--green);
    margin: 0;
    min-width: 60px;
    text-align: right;
  }

  :global(.remove-btn) {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--muted);
    font-size: 0.85rem;
    padding: 0.25rem;
    border-radius: 4px;
    transition: color 0.15s;
    line-height: 1;
  }
  :global(.remove-btn:hover) { color: #c0392b; }

  /* Summary */
  .cart-summary {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
    position: sticky;
    top: 120px;
  }

  .cart-summary h2 { font-size: 1.1rem; margin-bottom: 1.25rem; }

  :global(.summary-row) {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    font-family: 'DM Sans', sans-serif;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .summary-subtotal {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    font-family: 'DM Sans', sans-serif;
    color: var(--muted);
    padding-top: 0.75rem;
    margin-top: 0.75rem;
    border-top: 1px solid var(--border);
    margin-bottom: 0.5rem;
  }

  .summary-shipping {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    font-family: 'DM Sans', sans-serif;
    color: var(--muted);
    padding-top: 0.5rem;
    margin-top: 0;
  }

  .summary-total {
    display: flex;
    justify-content: space-between;
    font-weight: 700;
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    color: var(--green);
    padding-top: 0.75rem;
    margin-top: 0.75rem;
    border-top: 2px solid var(--border);
    margin-bottom: 1.25rem;
  }

  .btn-full { width: 120%; text-align: center; }

  .checkout-note {
    text-align: center;
    font-size: 0.75rem;
    color: var(--muted);
    font-family: 'DM Sans', sans-serif;
    margin: 0.5rem 0 1rem;
  }

  .checkout-trust {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  .checkout-trust li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-family: 'DM Sans', sans-serif;
    color: var(--text);
  }
  .check { color: var(--gold); font-weight: 700; }

  .shipping-savings {
    font-size: 0.75rem;
    font-family: 'DM Sans', sans-serif;
    color: #2d6a2d;
    margin: 0.1rem 0 0;
    text-align: right;
  }
  .shipping-savings strong { font-weight: 700; }

  .shipping-progress {
    margin: 0 0 0.75rem;
  }
  .shipping-progress-label {
    font-size: 0.78rem;
    font-family: 'DM Sans', sans-serif;
    color: var(--muted);
    margin: 0 0 0.4rem;
    text-align: center;
  }
  .shipping-progress-label strong { color: var(--gold); }
  .shipping-progress.is-unlocked .shipping-progress-label {
    color: #2d6a2d;
    font-weight: 600;
  }
  .progress-track {
    height: 6px;
    background: var(--border);
    border-radius: 99px;
    overflow: hidden;
  }
  .progress-bar {
    height: 120%;
    background: var(--gold);
    border-radius: 99px;
