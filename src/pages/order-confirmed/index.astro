---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Order Confirmed — Mayan Origin Coffee"
  description="Thank you for your order. Your coffee is being packed fresh in Honduras."
>
  <div class="confirmed-wrap container">
    <div class="confirmed-box">
      <div class="confirmed-icon">✓</div>
      <h1>Order Confirmed!</h1>
      <p class="confirmed-sub">Thank you for your order. A confirmation email is on its way to you.</p>
      <div class="confirmed-details">
        <div class="detail">
          <span class="detail-icon">📦</span>
          <div>
            <p class="detail-title">Being packed fresh in Honduras</p>
            <p class="detail-text">Your order will ship within 3 business days.</p>
          </div>
        </div>
        <div class="detail">
          <span class="detail-icon">✈️</span>
          <div>
            <p class="detail-title">DHL Express delivery</p>
            <p class="detail-text">Estimated arrival: 7–14 business days to the continental US.</p>
          </div>
        </div>
        <div class="detail">
          <span class="detail-icon">📧</span>
          <div>
            <p class="detail-title">Tracking number coming</p>
            <p class="detail-text">You'll receive a tracking email once your order ships.</p>
          </div>
        </div>
      </div>
      <a href="/shop/" class="btn btn-primary">Continue Shopping</a>
    </div>
  </div>
</BaseLayout>

<script>
  // Clear cart on successful order
  localStorage.removeItem('mo_cart');
  window.dispatchEvent(new Event('mo:cart-updated'));
</script>

<style>
  .confirmed-wrap {
    padding: 5rem 0;
    display: flex;
    justify-content: center;
  }

  .confirmed-box {
    max-width: 560px;
    width: 100%;
    text-align: center;
  }

  .confirmed-icon {
    width: 72px;
    height: 72px;
    background: var(--green);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin: 0 auto 1.5rem;
  }

  .confirmed-box h1 { font-size: 2rem; margin-bottom: 0.5rem; }
  .confirmed-sub { color: var(--muted); margin-bottom: 2.5rem; }

  .confirmed-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
    text-align: left;
  }

  .detail {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--cream);
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .detail-icon { font-size: 1.5rem; flex-shrink: 0; }
  .detail-title { font-weight: 600; font-family: 'DM Sans', sans-serif; margin: 0 0 0.2rem; font-size: 0.95rem; }
  .detail-text { font-size: 0.85rem; color: var(--muted); margin: 0; font-family: 'DM Sans', sans-serif; }
</style>
